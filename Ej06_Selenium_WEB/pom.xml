<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.5.2</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>

	<groupId>com.curso</groupId>
	<artifactId>Ej06_Selenium_WEB</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>Ej06_Selenium_WEB</name>
	<description>Aplicación de Ej06_Selenium_4 (servlets + JSP) arrancada con Spring Boot</description>
	<packaging>war</packaging>

	<properties>
		<java.version>11</java.version>
	</properties>

	<dependencies>
		<!--
			Sin spring-boot-starter-web a propósito: esa dependencia registra un
			DispatcherServlet de Spring MVC mapeado a "/", que se quedaría con TODAS
			las peticiones (también las de los .html/.css/.js estáticos) antes de que
			llegasen al servlet por defecto de Tomcat. Aquí no hay controladores @Controller,
			solo los @WebServlet/@WebFilter ya existentes, así que basta con levantar
			un Tomcat embebido "desnudo".
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-tomcat</artifactId>
		</dependency>

		<!--
			spring-web (no spring-webmvc): @ServletComponentScan lo necesita en el
			classpath para detectar el servidor embebido. No arrastra DispatcherServlet
			porque ese vive en spring-webmvc, que seguimos sin incluir.
		-->
		<dependency>
			<groupId>org.springframework</groupId>
			<artifactId>spring-web</artifactId>
		</dependency>

		<!-- Soporte JSP para el Tomcat embebido (no viene incluido por defecto) -->
		<dependency>
			<groupId>org.apache.tomcat.embed</groupId>
			<artifactId>tomcat-embed-jasper</artifactId>
		</dependency>

		<!-- JSTL: listadoClientes.jsp usa c:forEach, c:url y c:param -->
		<dependency>
			<groupId>javax.servlet</groupId>
			<artifactId>jstl</artifactId>
			<version>1.2</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
	</dependencies>

	<build>
		<finalName>Ej06_Selenium_WEB</finalName>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
